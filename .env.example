# OpenSSL Development Environment Configuration
# Copy this file to .env and fill in your values

# Cloudsmith Configuration (REQUIRED)
CLOUDSMITH_API_KEY=your-cloudsmith-api-key-here
CLOUDSMITH_ORG=${CONAN_REPOSITORY_NAME}
CLOUDSMITH_REPO=openssl-conan

# Development Environment
PYTHON_VERSION=3.12
CONAN_VERSION=2.0.17
CMAKE_VERSION=3.28.1

# Build Configuration
BUILD_TYPE=Release
CMAKE_GENERATOR=Ninja
CONAN_BUILD_JOBS=8

# Testing Configuration
TEST_PARALLEL_JOBS=4
COVERAGE_MINIMUM=80

# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=8080
MCP_LOG_LEVEL=INFO

# FIPS Configuration
FIPS_CERTIFICATE=4985
FIPS_SECURITY_LEVEL=1

# Performance Monitoring
PERFORMANCE_LOG_FILE=performance.log
BUILD_TIME_LOG=build_times.log
EOF && cat > scripts/monitor-performance.sh << 'EOF'
#!/bin/bash

echo "📊 OpenSSL Build Performance Monitor"
echo "==================================="

LOG_FILE="performance-logs/$(date +%Y%m%d-%H%M%S)-build-times.log"
mkdir -p performance-logs

log_time() {
    local operation="$1"
    local start_time="$2"
    local end_time="$3"
    local duration=$((end_time - start_time))
    
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $operation | ${duration}s" >> "$LOG_FILE"
    echo "⏱️  $operation: ${duration}s"
}

# Test foundation layer performance
echo "🔐 Testing Foundation Layer Performance..."
cd openssl-conan-base
START=$(date +%s)
conan create . --build=missing >/dev/null 2>&1
END=$(date +%s)
log_time "openssl-conan-base" "$START" "$END"
cd ..

# Test FIPS policy performance
cd openssl-fips-policy
START=$(date +%s)
conan create . --build=missing >/dev/null 2>&1
END=$(date +%s)
log_time "openssl-fips-policy" "$START" "$END"
cd ..

# Test tooling layer performance
cd openssl-tools
START=$(date +%s)
conan create . --build=missing >/dev/null 2>&1
END=$(date +%s)
log_time "openssl-tools" "$START" "$END"
cd ..

# Test domain layer general build
cd openssl
START=$(date +%s)
conan create . --build=missing -o deployment_target=general >/dev/null 2>&1
END=$(date +%s)
log_time "openssl-general" "$START" "$END"

# Test domain layer FIPS build
START=$(date +%s)
conan create . --build=missing -o deployment_target=fips-government >/dev/null 2>&1
END=$(date +%s)
log_time "openssl-fips" "$START" "$END"
cd ..

echo ""
echo "📈 Performance log saved to: $LOG_FILE"
echo "📊 Summary:"
echo "   - Foundation packages: < 1 minute total"
echo "   - Tooling layer: ~1 minute"
echo "   - OpenSSL general: 5-15 minutes"
echo "   - OpenSSL FIPS: 5-15 minutes (additional validation)"
