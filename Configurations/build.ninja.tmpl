{-
     use Time::Piece;

     use OpenSSL::Util;

     our $makedep_scheme = $config{makedep_scheme};
     our $makedepcmd = platform->makedepcmd();

     sub windowsdll { $config{target} =~ /^(?:Cygwin|mingw)/ }

     # Shared AIX support is special. We put libcrypto[64].so.ver into
     # libcrypto.a and use libcrypto_a.a as static one, unless using
     # shared_target style aix-solib.  In that mode, create
     # libcrypto.so as a link-import library that inserts runtime
     # dependencies on libcrypto.so.ver, and the static library is
     # named libcrypto.a.
     sub sharedaix  { !$disabled{shared} && $target{shared_target} =~ /^aix(?!-solib$)/ }                                                                       
     sub sharedaix_solib  { !$disabled{shared} && $target{shared_target} =~ /^aix-solib$/ }                                                                     

     our $sover_dirname = platform->shlib_version_as_filename();

     # Ninja-specific helper functions
     sub ninja_escape {
         my $str = shift;
         $str =~ s/([:\$\s])/\$$1/g;
         return $str;
     }

     sub ninja_path {
         my $path = shift;
         $path =~ s|\\|/|g;  # Convert backslashes to forward slashes
         return ninja_escape($path);
     }

     # Build directory and source directory
     our $builddir = ninja_path($config{builddir});
     our $sourcedir = ninja_path($config{sourcedir});
     
     # Compiler and tool variables
     our $CC = ninja_escape($config{CC});
     our $CXX = ninja_escape($config{CXX} || $config{CC});
     our $AR = ninja_escape($config{AR});
     our $RANLIB = ninja_escape($config{RANLIB});
     our $RC = ninja_escape($config{RC});
     
     # Flags
     our $CFLAGS = join(" ", map { ninja_escape($_) } @{$config{CFLAGS}});
     our $CPPFLAGS = join(" ", map { ninja_escape($_) } @{$config{CPPDEFINES}}, @{$config{CPPINCLUDES}});
     our $LDFLAGS = join(" ", map { ninja_escape($_) } @{$config{LDFLAGS}});
     our $LDLIBS = join(" ", map { ninja_escape($_) } @{$config{LDLIBS}});
     
     # File extensions
     our $objext = $target{obj_extension} || ".o";
     our $exeext = $target{exe_extension} || "";
     our $libext = $target{lib_extension} || ".a";
     our $shlibext = $target{shared_extension} || ".so";
     
     # Build rules
     our $compile_rule = "compile_c";
     our $compile_cpp_rule = "compile_cpp";
     our $link_exe_rule = "link_exe";
     our $link_lib_rule = "link_lib";
     our $link_dso_rule = "link_dso";
     
     if ($config{target} =~ /^VC-/) {
         # Windows MSVC specific
         $compile_rule = "compile_c_msvc";
         $compile_cpp_rule = "compile_cpp_msvc";
         $link_exe_rule = "link_exe_msvc";
         $link_lib_rule = "link_lib_msvc";
         $link_dso_rule = "link_dso_msvc";
     }
     
     "";
-}
# Generated by Configure from Configurations/build.ninja.tmpl
# OpenSSL Ninja build file

builddir = {- $builddir -}
sourcedir = {- $sourcedir -}

# Compiler variables
CC = {- $CC -}
CXX = {- $CXX -}
AR = {- $AR -}
RANLIB = {- $RANLIB -}
RC = {- $RC -}

# Flags
CFLAGS = {- $CFLAGS -}
CPPFLAGS = {- $CPPFLAGS -}
LDFLAGS = {- $LDFLAGS -}
LDLIBS = {- $LDLIBS -}

# Build rules
rule compile_c
  command = $CC -MMD -MT $out -MF $out.d $CFLAGS $CPPFLAGS -c $in -o $out
  description = CC $out
  depfile = $out.d
  deps = gcc

rule compile_cpp
  command = $CXX -MMD -MT $out -MF $out.d $CFLAGS $CPPFLAGS -c $in -o $out
  description = CXX $out
  depfile = $out.d
  deps = gcc

rule link_exe
  command = $CC $LDFLAGS $in -o $out $LDLIBS
  description = LINK $out

rule link_lib
  command = $AR rcs $out $in
  description = AR $out

rule link_dso
  command = $CC -shared $LDFLAGS $in -o $out $LDLIBS
  description = DSO $out

# Windows MSVC rules
rule compile_c_msvc
  command = $CC /nologo $CFLAGS $CPPFLAGS /c $in /Fo$out
  description = CC $out

rule compile_cpp_msvc
  command = $CXX /nologo $CFLAGS $CPPFLAGS /c $in /Fo$out
  description = CXX $out

rule link_exe_msvc
  command = $CC /nologo $LDFLAGS $in /Fe$out $LDLIBS
  description = LINK $out

rule link_lib_msvc
  command = $AR /nologo $in /OUT:$out
  description = LIB $out

rule link_dso_msvc
  command = $CC /nologo /DLL $LDFLAGS $in /Fe$out $LDLIBS
  description = DLL $out

# Resource compilation (Windows)
rule compile_rc
  command = $RC $CPPFLAGS $in /fo$out
  description = RC $out

# Build statements for object files
{-
    # Generate build statements for each object file
    foreach my $obj (sort keys %{$unified_info{sources}}) {
        my $src = $unified_info{sources}->{$obj}->[0];
        my $rule = $src =~ /\.c$/ ? $compile_rule : $compile_cpp_rule;
        
        $OUT .= "build " . ninja_path($obj) . ": $rule " . 
                ninja_path($src) . "\n";
        
        # Add dependencies if any
        if (exists $unified_info{depends}->{$obj}) {
            my @deps = map { ninja_path($_) } @{$unified_info{depends}->{$obj}};
            $OUT .= "  deps = " . join(" ", @deps) . "\n";
        }
        $OUT .= "\n";
    }
    
    # Generate library targets
    foreach my $lib (sort keys %{$unified_info{libraries}}) {
        my @objs = map { ninja_path($_) } 
                   @{$unified_info{sources}->{$lib}};
        
        if (@objs) {
            $OUT .= "build " . ninja_path($lib) . ": $link_lib_rule " . 
                    join(" ", @objs) . "\n\n";
        }
    }
    
    # Generate shared library targets
    foreach my $shlib (sort keys %{$unified_info{sharedsources}}) {
        my @objs = map { ninja_path($_) } 
                   @{$unified_info{sources}->{$shlib}};
        
        if (@objs) {
            $OUT .= "build " . ninja_path($shlib) . ": $link_dso_rule " . 
                    join(" ", @objs) . "\n\n";
        }
    }
    
    # Generate executable targets
    foreach my $exe (sort keys %{$unified_info{programs}}) {
        my @objs = map { ninja_path($_) }
                   @{$unified_info{sources}->{$exe}};
        my @libs = map { ninja_path($_) }
                   @{$unified_info{depends}->{$exe}};
        
        if (@objs) {
            $OUT .= "build " . ninja_path($exe) . ": $link_exe_rule " .
                    join(" ", @objs, @libs) . "\n\n";
        }
    }
    
    "";
-}

# Default target
default {- join(" ", map { ninja_path($_) } @{$unified_info{libraries}}, @{$unified_info{sharedsources}}, @{$unified_info{programs}}) -}

# Install target
build install: phony
  command = {- $config{perl} -} {- $sourcedir -}/util/mkdir-p.pl $
              {- join(" ", map { ninja_path($_) } @{$config{install_paths}}) -}
  description = Installing OpenSSL

# Test targets
{-
    foreach my $test (@{$unified_info{tests}}) {
        $OUT .= "build test_" . $test . ": phony " . 
                ninja_path($unified_info{programs}->{$test}) . "\n";
    }
    
    "";
-}

build test: phony {- join(" ", map { "test_$_" } @{$unified_info{tests}}) -}

# Clean target
build clean: phony
  command = rm -rf {- join(" ", map { ninja_path($_) } @{$unified_info{cleanfiles}}) -}
  description = Cleaning build files



