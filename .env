# OpenSSL Development Environment Configuration

# Cloudsmith Configuration
CLOUDSMITH_API_KEY=your-api-key-here
CLOUDSMITH_ORG=${CONAN_REPOSITORY_NAME}
CLOUDSMITH_REPO=openssl-conan

# Development Environment
PYTHON_VERSION=3.12
CONAN_VERSION=2.0.17
CMAKE_VERSION=3.28.1

# Repository Paths (relative to workspace root)
OPENSSL_CONAN_BASE=openssl-conan-base
OPENSSL_FIPS_POLICY=openssl-fips-policy
OPENSSL_TOOLS=openssl-tools
FUZZ_CORPORA=fuzz-corpora
OPENSSL=openssl
MCP_PROJECT_ORCHESTRATOR=mcp-project-orchestrator
OPENSSL_DOCS=openssl-docs
LIBCURL=libcurl

# Build Configuration
BUILD_TYPE=Release
CMAKE_GENERATOR=Ninja
CONAN_BUILD_JOBS=8

# Testing Configuration
TEST_PARALLEL_JOBS=4
COVERAGE_MINIMUM=80

# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=8080
MCP_LOG_LEVEL=INFO

# FIPS Configuration
FIPS_CERTIFICATE=4985
FIPS_SECURITY_LEVEL=1

# Performance Monitoring
PERFORMANCE_LOG_FILE=performance.log
BUILD_TIME_LOG=build_times.log
